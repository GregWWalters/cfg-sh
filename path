# PATH additions
# TODO: find a way to load these _after_ the system sets the path so that
# priority can be given to user binaries, but in a way other than having to
# source it from each particular shell's config file.

if [ -z "$PATH_LOADED" ]; then
  export PATH_LOADED=1;

  # Homebrew-Installed Executables
  if [ -n "$HOMEBREW_PREFIX" ]; then
    PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"     # gnu coreutils
    PATH="$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin:$PATH"       # gnu sed
    PATH="$HOMEBREW_PREFIX/opt/grep/libexec/gnubin:$PATH"          # gnu grep
    MANPATH="/usr/local/opt/coreutils/libexec/gnuman:$MANPATH"     # gnu man pages
    if [ -d "$HOMEBREW_PREFIX/opt/libpq/bin" ]; then
      PATH="$HOMEBREW_PREFIX/opt/libpq/bin:$PATH"                  # Postgres CLI
    fi
    if [ -d "$HOMEBREW_PREFIX/opt/rustup" ]; then
      PATH="/opt/homebrew/opt/rustup:$PATH"                        # Rust toolchain
    fi
  fi

  # Language Toolchain-Installed Executables
  if [ -d "$HOME/.cargo" ]; then PATH="$HOME/.cargo/bin:$PATH"; fi # Rust bins
  if [ -d "$HOME/go" ]; then PATH="$HOME/go/bin:$PATH"; fi         # Go bins

  # Prefer Volta binaries
  if [ -d $HOME/.volta/bin ]; then
    PATH="$HOME/.volta/bin:$PATH"
  fi

  # User Executables
  if [ -d "$HOME/bin" ]; then; PATH="$HOME/bin:$PATH"; fi
  if [ -d "$HOME/.local/bin" ]; then PATH="$HOME/bin:$PATH"; fi
  if [ -d "$XDG_CONFIG_HOME/git/funcs" ]; then
    PATH="$PATH:$XDG_CONFIG_HOME/git/funcs"                        # git functions
  fi
  PATH="$HOME/.local/bin:$PATH"                               # user bins

  # $HOME/bin/**
  if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
    for d in $(find $HOME/bin \
      -maxdepth 2 -type f -perm -111 \
      -exec dirname {} ';'); do
      if [ "${PATH#*$d}" = "$PATH" ]; then
        PATH="$PATH:$d"
      fi
    done
  fi

  # $HOME/.local/bin/**
  if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
    for d in $(find $HOME/.local/bin \
      -maxdepth 2 -type f -perm -111 \
      -exec dirname {} ';'); do
      if [ "${PATH#*$d}" = "$PATH" ]; then
        PATH="$PATH:$d"
      fi
    done
  fi

  # $HOME/go/bin/**
  if [ -d "$HOME/go/bin" ]; then
    PATH="$HOME/go/bin:$PATH"
    for d in $(find $HOME/go/bin \
      -maxdepth 2 -type f -perm -111 \
      -exec dirname {} ';'); do
      if [ "${PATH#*$d}" = "$PATH" ]; then
        PATH="$PATH:$d"
      fi
    done
  fi


  # Man pages
  MANPATH="$MANPATH:$HOME/man"

  export PATH MANPATH
fi

# vim:ft=sh
